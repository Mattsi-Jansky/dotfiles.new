theme = Catppuccin Mocha
# Run nushell in the terminal without making it the login shell
command = /home/mattsi/.cargo/bin/nu
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+alt+d=new_split:down
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right
keybind = alt+up=goto_split:up
keybind = alt+down=goto_split:down
keybind = ctrl+shift+enter=toggle_split_zoom
